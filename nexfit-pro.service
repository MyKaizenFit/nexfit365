[Unit]
Description=Nex-Fit PRO Application - safe bootstrap
Documentation=https://nexfit365.dpdns.org
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/mykaizenfit/pro
Environment="COMPOSE_PROJECT_NAME=nexfit-pro"
Environment="COMPOSE_FILE=docker-compose.prod.yml"
EnvironmentFile=-/srv/mykaizenfit/pro/.env.production

# Bootstrap only. Routine deployments must use /srv/mykaizenfit/pro/deploy.sh.
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml up -d db redis db-backup backend celery_worker frontend

# A systemd stop must not destroy the Docker network/stack.
ExecStop=/bin/true

# A systemd reload must not force-recreate production containers.
ExecReload=/bin/true

TimeoutStartSec=600
TimeoutStopSec=30
Restart=on-failure
RestartSec=10s
KillMode=process
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
